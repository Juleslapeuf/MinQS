url_wijken_avec_eau <- paste0(
"https://maps.amsterdam.nl/open_geodata/geojson_lnglat.php",
"?KAARTLAAG=INDELING_WIJK&THEMA=gebiedsindeling"
)
couleur_eau <- "#bcd7ea"
charger_eau <- function(wijken_terre, afficher = TRUE, dossier = "data",
rafraichir = FALSE) {
if (!afficher) return(NULL)
fichier <- file.path(dossier, "wijken_avec_eau_amsterdam.geojson")
if (rafraichir || !file.exists(fichier))
download.file(url_wijken_avec_eau, fichier, mode = "wb", quiet = TRUE)
complet <- st_read(fichier, quiet = TRUE)
if (is.na(st_crs(complet))) st_crs(complet) <- 4326
st_sf(geometry = st_union(
st_geometry(st_transform(st_make_valid(complet), st_crs(wijken_terre)))
))
}
# Couche ggplot à ajouter EN PREMIER (ne fait rien si eau = NULL)
fond_eau <- function(eau) {
if (is.null(eau)) return(NULL)
geom_sf(data = eau, fill = couleur_eau, color = NA)
}
# Cadre de la carte sur la ville (hors eau), avec une marge en mètres :
# évite que les grandes étendues d'eau (IJmeer, Markermeer...) dézooment la carte.
cadre_ville <- function(wijken_terre, marge = 500) {
b <- st_bbox(wijken_terre)
coord_sf(xlim = c(b[["xmin"]] - marge, b[["xmax"]] + marge),
ylim = c(b[["ymin"]] - marge, b[["ymax"]] + marge),
expand = FALSE)
}
eau <- charger_eau(districts)
ggplot() + fond_eau(eau) + geom_sf(data = districts) + cadre_ville(districts)
ggplot() + fond_eau(charger_eau(districts)) + geom_sf(data = districts) + cadre_ville(districts)
ggplot() + fond_eau(charger_eau(districts)) + geom_sf(data = districts)
load_water <- function(districts, afficher = TRUE, dossier = "data",
rafraichir = FALSE) {
if (!afficher) return(NULL)
fichier <- file.path(dossier, "wijken_with_water_amsterdam.geojson")
if (rafraichir || !file.exists(fichier))
download.file(url_districts_with_water, fichier, mode = "wb", quiet = TRUE)
complet <- st_read(fichier, quiet = TRUE)
if (is.na(st_crs(complet))) st_crs(complet) <- 4326
st_sf(geometry = st_union(
st_geometry(st_transform(st_make_valid(complet), st_crs(districts)))
))
}
add_water <- function(water) {
if (is.null(water)) return(NULL)
geom_sf(data = water, fill = "#bcd7ea", color = NA)
}
View(districts)
View(eau)
rm(list = ls())
